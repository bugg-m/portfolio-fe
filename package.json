{
  "name": "@portfolio-fe/source",
  "version": "2.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "nx reset",
    "start:host": "nx serve host --skip-remotes=react_mfe,next_mfe,vue_mfe",
    "build:host": "nx build host --skip-remotes=react_mfe,next_mfe,vue_mfe",
    "start:react_mfe": "nx serve react_mfe",
    "build:react_mfe": "nx build react_mfe",
    "start:next_mfe": "nx serve next_mfe",
    "build:next_mfe": "nx build next_mfe",
    "start:vue_mfe": "nx serve vue_mfe",
    "build:vue_mfe": "nx build vue_mfe",
    "start:all": "nx run-many --target=serve --projects=host,react_mfe,next_mfe,vue_mfe --parallel --max-parallel=4 --skip-remotes=react_mfe,next_mfe,vue_mfe",
    "build:all": "nx run-many --target=build --projects=host,react_mfe,next_mfe,vue_mfe",
    "lint": "eslint '{packages,apps}/**/*.{ts,tsx}'",
    "lint:fix": "eslint '{packages,apps}/**/*.{ts,tsx}' --fix",
    "test": "nx run-many --target=test --projects=host,react_mfe,next_mfe,vue_mfe",
    "format": "prettier --write ."
  },
  "private": true,
