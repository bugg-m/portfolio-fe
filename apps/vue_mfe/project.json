{
  "name": "vue_mfe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vue_mfe/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/vue_mfe",
        "index": "apps/vue_mfe/src/index.html",
        "main": "apps/vue_mfe/src/main.ts",
        "tsConfig": "apps/vue_mfe/tsconfig.app.json",
        "styles": ["global.tailwind"],
        "postcssConfig": "postcss.config.js"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "vue_mfe:build",
        "hmr": true,
        "port": 9003
      },
      "configurations": {
        "development": {
          "buildTarget": "vue_mfe:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "vue_mfe:build:production",
          "hmr": false
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "vue_mfe:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "vue_mfe:build:development"
        },
        "production": {
          "buildTarget": "vue_mfe:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/vue_mfe"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  },
  "tags": []
}
