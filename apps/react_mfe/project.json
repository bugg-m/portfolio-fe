{
  "name": "react_mfe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/react_mfe",
  "sourceRoot": "apps/react_mfe/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/react_mfe",
        "index": "apps/react_mfe/src/index.html",
        "baseHref": "/",
        "main": "apps/react_mfe/src/main.ts",
        "tsConfig": "apps/react_mfe/tsconfig.app.json",
        "assets": ["apps/react_mfe/src/favicon.ico", "apps/react_mfe/src/assets"],
        "rspackConfig": "apps/react_mfe/rspack.config.ts",
        "styles": ["global.tailwind"],
        "postcssConfig": "postcss.config.js",
        "scripts": [],
        "configurations": {
          "development": {
            "mode": "development"
          },
          "production": {
            "mode": "production",
            "optimization": true,
            "sourceMap": false,
            "outputHashing": "all",
            "namedChunks": false,
            "extractLicenses": true,
            "vendorChunk": false
          }
        },
        "target": "web"
      },
      "configurations": {
        "production": {
          "rspackConfig": "apps/react_mfe/rspack.config.prod.ts"
        }
      }
    },
    "serve": {
      "executor": "@nx/rspack:module-federation-dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "react_mfe:build",
        "hmr": true,
        "port": 9001
      },
      "configurations": {
        "development": {
          "buildTarget": "react_mfe:build:development"
        },
        "production": {
          "buildTarget": "react_mfe:build:production",
          "hmr": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "executor": "@nx/rspack:module-federation-static-server",
      "defaultConfiguration": "production",
      "options": {
        "serveTarget": "react_mfe:serve"
      },
      "configurations": {
        "development": {
          "serveTarget": "react_mfe:serve:development"
        },
        "production": {
          "serveTarget": "react_mfe:serve:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/react_mfe/jest.config.ts"
      }
    }
  }
}
