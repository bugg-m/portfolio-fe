{
  "name": "next_mfe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/next_mfe/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/next_mfe"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/next_mfe"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "next_mfe:build",
        "dev": true,
        "port": 9002
      },
      "configurations": {
        "development": {
          "buildTarget": "next_mfe:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "next_mfe:build:production",
          "dev": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
